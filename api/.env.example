# GoalCoach environment variables — copy to `.env` and fill in.
#
# Source of truth: migration/discovery/03-nextjs-architecture.md Section 6.
# Required keys are uncommented. Optional keys are kept commented so a fresh
# checkout doesn't ship enabled-by-default values that aren't actually used.
#
# This file is checked in. NEVER put real secrets here.

# ---------- App ----------
# NEXT_PUBLIC_APP_URL=https://v2.goalcoach.com

# ---------- Database (Supabase Postgres) ----------
# Two connection strings:
#  - DATABASE_URL            : pooled (Transaction pooler), used by the runtime
#  - DATABASE_URL_UNPOOLED   : direct, used by drizzle-kit for migrations and
#                              by long-running scripts (db/migrate-from-mongo.ts)
#                              Both point at the same Supabase project — Dashboard
#                              → Project Settings → Database → Connection string.
#                              DATABASE_URL        = "Transaction pooler" (:6543)
#                              DATABASE_URL_UNPOOLED = "Direct connection"  (:5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL_UNPOOLED=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Driver: lib/db.ts is pinned to node-postgres ("pg"). DATABASE_URL_DRIVER is
# not read by any code — the value below is inert and safe to delete.
DATABASE_URL_DRIVER=pg

# ---------- LLM backend ----------
# Two backends are supported. Whichever one is configured takes
# precedence; the other is ignored.
#
# (A) DeepSeek — MVP default. OpenAI-compatible `/v1/chat/completions`.
#     Set DEEPSEEK_API_KEY to route streamChat() through DeepSeek
#     instead of the Emergent proxy. URL defaults to api.deepseek.com.
#
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_URL=https://api.deepseek.com

# (B) Emergent — fallback. Single key for auth + LLM + storage. Must
# start with `sk-emergent-`. Used when DEEPSEEK_API_KEY is unset.
# Get yours at https://emergentagent.com.
EMERGENT_LLM_KEY=

# Optional override for the Emergent integrations proxy.
INTEGRATION_PROXY_URL=https://integrations.emergentagent.com

# ---------- Guest-token + cookies ----------
# Used to sign the 10-minute HMAC cookie (locked decision #3).
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
# AUTH_URL=https://v2.goalcoach.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- ETL (db/migrate-from-mongo.ts) — optional ----------
# MONGODB_URL=mongodb://localhost:27017
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=goalcoach
# MONGO_DB_NAME=goalcoach

# ---------- Optional ----------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SENTRY_DSN=