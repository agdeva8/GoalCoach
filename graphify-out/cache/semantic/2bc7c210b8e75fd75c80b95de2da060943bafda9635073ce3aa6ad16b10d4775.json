{"nodes": [{"id": "design_guidelines", "label": "GoalCoach Design Guidelines", "file_type": "document", "source_file": "design_guidelines.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_guidelines_swiss_archetype", "label": "Swiss & High-Contrast Command Center Archetype", "file_type": "rationale", "source_file": "design_guidelines.json", "source_location": "5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ARCHETYPE 4: monochromatic architectural density, sharp hairline grids, high-contrast monospace accents, tactical state indicators, pure utilitarian focus."}, {"id": "design_guidelines_brand_voice", "label": "GoalCoach Brand Voice", "file_type": "rationale", "source_file": "design_guidelines.json", "source_location": "4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Precise, curious, rigorous, direct. Zero slop, zero cheerleading, zero fluff. The honest coach is harder to like but easier to trust."}, {"id": "design_guidelines_dual_pane_layout", "label": "Desktop-First Dual-Pane Split Layout", "file_type": "rationale", "source_file": "design_guidelines.json", "source_location": "57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed top header (z-50 backdrop-blur); 12-col grid with 7-col chat panel + 5-col dashboard panel; mobile collapses to tabbed/stacked layout."}, {"id": "design_guidelines_tool_confirmation_pattern", "label": "MCP-Style State Writer Confirmation Pattern", "file_type": "rationale", "source_file": "design_guidelines.json", "source_location": "79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LLM cannot modify goal state silently. Any tool call proposal MUST present an inline prompt in chat for user confirmation. Ensures exact synchronization between chat state changes (upon user confirmation) and the tracking dashboard view."}, {"id": "design_guidelines_honesty_audit_pattern", "label": "Honesty Audit Pattern", "file_type": "rationale", "source_file": "design_guidelines.json", "source_location": "96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audit trail log showing history of coach commitments, state mutations, dates, and tool calls; exportable as JSON/CSV. Lets the user verify the coach has been honest, not just trust it."}, {"id": "design_guidelines_accessibility", "label": "WCAG 2.1 AA Accessibility Requirements", "file_type": "rationale", "source_file": "design_guidelines.json", "source_location": "121", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full keyboard navigation, aria-live='polite' on streaming chat responses, role='log' on chat thread, role='status' on over-commitment indicators, respect prefers-reduced-motion, kebab-case data-testid on every interactive element."}], "edges": [{"source": "design_guidelines_honesty_audit_pattern", "target": "components_honestyauditview", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design_guidelines.json", "source_location": "96", "weight": 1.0}, {"source": "design_guidelines_tool_confirmation_pattern", "target": "components_toolconfirmationprompt", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design_guidelines.json", "source_location": "79", "weight": 1.0}, {"source": "design_guidelines_dual_pane_layout", "target": "src_app", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "design_guidelines.json", "source_location": "57", "weight": 1.0}, {"source": "design_guidelines_dual_pane_layout", "target": "components_header", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "design_guidelines.json", "source_location": "59", "weight": 1.0}, {"source": "design_guidelines_brand_voice", "target": "components_aboutmodal", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "design_guidelines.json", "source_location": "4", "weight": 1.0}, {"source": "design_guidelines_brand_voice", "target": "components_signinmodal", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "design_guidelines.json", "source_location": "4", "weight": 1.0}, {"source": "design_guidelines_accessibility", "target": "testids_index", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "design_guidelines.json", "source_location": "126", "weight": 1.0}, {"source": "design_guidelines_accessibility", "target": "components_signinmodal", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "design_guidelines.json", "source_location": "123", "weight": 1.0}], "hyperedges": []}